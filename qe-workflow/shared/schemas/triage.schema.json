{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test run triage",
  "type": "object",
  "required": ["run_id", "failures"],
  "properties": {
    "run_id": { "type": "string" },
    "pipeline_url": { "type": "string" },
    "build": { "type": "string" },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test", "category", "confidence", "evidence", "route"],
        "properties": {
          "test": { "type": "string" },
          "tc_id": { "type": "string" },
          "category": { "enum": ["product_bug", "test_bug", "environment", "flaky", "test_data"] },
          "sub_type": { "enum": ["locator_drift", "timing_wait", "test_data_refresh", "assertion_outdated", "logic_error", "none"] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "evidence": { "type": "string" },
          "error_signature": { "type": "string" },
          "route": { "enum": ["defect-raising", "pipeline-self-heal", "notify-env-owner", "quarantine", "human-review"] }
        }
      }
    },
    "summary": { "type": "object" }
  }
}
